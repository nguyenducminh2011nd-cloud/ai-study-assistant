<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trợ Lý Học Tập C3 - Personal AI</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #0f0f10; color: #e1e1e6; display: flex; height: 100vh; overflow: hidden; }

        /* Sidebar bên trái */
        .sidebar { width: 260px; background-color: #161618; border-right: 1px solid #27272a; display: flex; flex-direction: column; padding: 20px; }
        .brand { font-size: 1.2rem; font-weight: bold; color: #3b82f6; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }
        .new-chat-btn { background-color: #27272a; color: #fff; border: 1px solid #3f3f46; padding: 10px 15px; border-radius: 8px; cursor: pointer; transition: 0.2s; font-weight: 500; }
        .new-chat-btn:hover { background-color: #3f3f46; }
        .info-card { margin-top: auto; background-color: #1c1c1f; padding: 12px; border-radius: 8px; border: 1px solid #27272a; font-size: 0.85rem; color: #a1a1aa; }

        /* Khung Chat chính */
        .main-chat { flex: 1; display: flex; flex-direction: column; background-color: #0f0f10; }
        .chat-header { height: 60px; border-bottom: 1px solid #27272a; display: flex; align-items: center; padding: 0 25px; font-weight: 600; color: #f4f4f5; justify-content: space-between; }
        .status-dot { width: 8px; height: 8px; background-color: #22c55e; border-radius: 50%; display: inline-block; margin-right: 8px; }
        
        .chat-messages { flex: 1; padding: 25px; overflow-y: auto; display: flex; flex-direction: column; gap: 20px; }
        .message { display: flex; gap: 15px; max-width: 80%; line-height: 1.6; }
        .message.user { align-self: flex-end; flex-direction: row-reverse; }
        .message.bot { align-self: flex-start; }

        .avatar { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: bold; flex-shrink: 0; }
        .user .avatar { background-color: #2563eb; color: white; }
        .bot .avatar { background-color: #10b981; color: white; }

        .bubble { padding: 12px 18px; border-radius: 12px; font-size: 0.95rem; white-space: pre-wrap; }
        .user .bubble { background-color: #2563eb; color: #fff; border-bottom-right-radius: 2px; }
        .bot .bubble { background-color: #18181b; border: 1px solid #27272a; color: #e1e1e6; border-bottom-left-radius: 2px; }

        /* Khung nhập liệu */
        .input-area { padding: 20px 25px; background-color: #0f0f10; border-top: 1px solid #27272a; }
        .input-box { display: flex; background-color: #18181b; border: 1px solid #27272a; border-radius: 10px; padding: 8px 12px; transition: 0.2s; }
        .input-box:focus-within { border-color: #3b82f6; }
        input { flex: 1; background: transparent; border: none; outline: none; color: white; padding: 8px; font-size: 0.95rem; }
        button.send-btn { background-color: #2563eb; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; transition: 0.2s; }
        button.send-btn:hover { background-color: #1d4ed8; }

        /* Responsiveness cho mobile */
        @media (max-width: 768px) {
            .sidebar { display: none; }
            .message { max-width: 90%; }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="brand">🎓 AI Study Assistant</div>
        <button class="new-chat-btn" onclick="clearChat()">+ Đoạn chat mới</button>
        <div class="info-card">
            📌 <b>Trợ lý Cấp 3</b><br>
            Đang hoạt động trên Web cá nhân.
        </div>
    </div>

    <!-- Main Chat Area -->
    <div class="main-chat">
        <div class="chat-header">
            <div><span class="status-dot"></span> AI Trợ Lý Học Tập</div>
            <small style="color: #71717a; font-weight: normal;">THPT Target 3 Năm</small>
        </div>

        <div class="chat-messages" id="chatBox">
            <div class="message bot">
                <div class="avatar">AI</div>
                <div class="bubble">Xin chào Minh! Tôi là trợ lý AI đồng hành cùng bạn trong 3 năm cấp 3 tại THPT Nam Trực. Chúng ta bắt đầu nhé! 🚀</div>
            </div>
        </div>

        <div class="input-area">
            <div class="input-box">
                <input type="text" id="userInput" placeholder="Nhập câu hỏi hoặc bài tập cần giải..." onkeydown="handleKeyPress(event)">
                <button class="send-btn" onclick="sendMessage()">Gửi</button>
            </div>
        </div>
    </div>

    <script>
        function sendMessage() {
            let input = document.getElementById("userInput");
            let text = input.value.trim();
            if (!text) return;

            let chatBox = document.getElementById("chatBox");

            // Tin nhắn Người dùng
            let userMsg = document.createElement("div");
            userMsg.className = "message user";
            userMsg.innerHTML = `<div class="avatar">Tôi</div><div class="bubble">${escapeHtml(text)}</div>`;
            chatBox.appendChild(userMsg);

            input.value = "";
            chatBox.scrollTop = chatBox.scrollHeight;

            // Phản hồi mẫu từ trợ lý AI cá nhân
            setTimeout(() => {
                let botMsg = document.createElement("div");
                botMsg.className = "message bot";
                botMsg.innerHTML = `<div class="avatar">AI</div><div class="bubble">Tôi đã nhận câu hỏi: "${escapeHtml(text)}". Sẵn sàng hỗ trợ bạn chinh phục các mục tiêu cấp 3!</div>`;
                chatBox.appendChild(botMsg);
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 600);
        }

        function handleKeyPress(e) {
            if (e.key === 'Enter') sendMessage();
        }

        function clearChat() {
            document.getElementById("chatBox").innerHTML = `
                <div class="message bot">
                    <div class="avatar">AI</div>
                    <div class="bubble">Đã làm mới đoạn chat! Bạn cần giúp gì tiếp theo?</div>
                </div>`;
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
</body>
</html>
